import "raylib.nari"

func distance(x1, y1, x2, y2) {
  let dx = x2 - x1
  let dy = y2 - y1
  return math.sqrt(dx * dx + dy * dy)
}

Raylib.InitWindow(1280, 960, "ball physics thing")
Raylib.SetWindowMonitor(0)

// physics
let gravity = 2750.0
let air_drag = 0.1
let ground_friction = 3.0
let bounce_damping = 0.75
let max_speed = 100000.0

// ball
let ball_x = 400.0
let ball_y = 300.0
let ball_vx = 0.0
let ball_vy = 0.0
let ball_radius = 60.0

// mouse
let is_grabbed = false
let prev_mouse_x = 0.0
let prev_mouse_y = 0.0
let grab_offset_x = 0.0
let grab_offset_y = 0.0

// mouse velocity
let mouse_vx = 0.0
let mouse_vy = 0.0

let win_width = Raylib.GetScreenWidth()
let win_height = Raylib.GetScreenHeight()

while (!Raylib.WindowShouldClose()) {
  if (Raylib.IsKeyPressed(KEY_ENTER)) {
      break;
  }

  // clamp dt
  let dt = math.min(Raylib.GetFrameTime(), 0.033)
  let safe_dt = math.max(dt, 0.0001)

  let mouse_x = Raylib.GetMouseX()
  let mouse_y = Raylib.GetMouseY()

  // mouse velocity smoothing
  let raw_mouse_vx = (mouse_x - prev_mouse_x) / safe_dt
  let raw_mouse_vy = (mouse_y - prev_mouse_y) / safe_dt

  let smoothing = 0.2
  mouse_vx = mouse_vx + (raw_mouse_vx - mouse_vx) * smoothing
  mouse_vy = mouse_vy + (raw_mouse_vy - mouse_vy) * smoothing

  let dist_to_ball = distance(mouse_x, mouse_y, ball_x, ball_y)
  let is_over_ball = dist_to_ball <= ball_radius

  if (Raylib.IsMouseButtonPressed(MOUSE_LEFT_BUTTON) && is_over_ball) {
    is_grabbed = true
    grab_offset_x = ball_x - mouse_x
    grab_offset_y = ball_y - mouse_y
    prev_mouse_x = mouse_x
    prev_mouse_y = mouse_y
    mouse_vx = 0
    mouse_vy = 0
  }

  if (Raylib.IsMouseButtonReleased(MOUSE_LEFT_BUTTON) && is_grabbed) {
    is_grabbed = false
    ball_vx = mouse_vx * 0.8
    ball_vy = mouse_vy * 0.8
  }

  if (is_grabbed) {
    ball_x = mouse_x + grab_offset_x
    ball_y = mouse_y + grab_offset_y

    ball_vx = 0
    ball_vy = 0
  } else {
    // gravity
    ball_vy = ball_vy + gravity * dt

    // air drag
    ball_vx = ball_vx - ball_vx * air_drag * dt
    ball_vy = ball_vy - ball_vy * air_drag * dt

    // clamp max speed
    let speed = math.sqrt(ball_vx * ball_vx + ball_vy * ball_vy)
    if (speed > max_speed) {
      let scale = max_speed / speed
      ball_vx = ball_vx * scale
      ball_vy = ball_vy * scale
    }

    // integrate
    ball_x = ball_x + ball_vx * dt
    ball_y = ball_y + ball_vy * dt

    // wall bounce
    if (ball_x <= ball_radius) {
      ball_x = ball_radius
      ball_vx = -ball_vx * bounce_damping
    }

    if (ball_x >= win_width - ball_radius) {
      ball_x = win_width - ball_radius
      ball_vx = -ball_vx * bounce_damping
    }

    // floor
    if (ball_y >= win_height - ball_radius) {
      ball_y = win_height - ball_radius
      ball_vy = -ball_vy * bounce_damping

      // ground friction only when touching floor
      ball_vx = ball_vx - ball_vx * ground_friction * dt

      // no tiny bounce
      if (math.abs(ball_vy) < 30) {
        ball_vy = 0
      }

      if (math.abs(ball_vx) < 5) {
        ball_vx = 0
      }
    }

    // ceiling
    if (ball_y <= ball_radius) {
      ball_y = ball_radius
      ball_vy = -ball_vy * bounce_damping
    }
  }

  prev_mouse_x = mouse_x
  prev_mouse_y = mouse_y

  // draw
  Raylib.BeginDrawing()
  Raylib.ClearBackground(BLACK)
  
  Raylib.DrawCircle(ball_x, ball_y, ball_radius, RED)

  if (is_over_ball && !is_grabbed) {
    Raylib.DrawCircleLines(ball_x, ball_y, ball_radius + 2, RAYWHITE)
  }

  let fontSize = 30;
  let text = "Click and drag ball to throw";
  let textWidth = Raylib.MeasureText(text, fontSize);

  Raylib.DrawText(text, (win_width / 2 - textWidth / 2), 20, 30, RAYWHITE)

  Raylib.DrawFPS(10, 10)

  Raylib.DrawText(
  Raylib.TextFormat("Velocity: (%.1f, %.1f)", [ball_vx, ball_vy]),
  10, 50, 20, SKYBLUE
  )

  Raylib.EndDrawing()
}
