import "raylib.nari"

func start() {
    let rect = { width: 300.0, height: 300.0, x: 10.0, y: 10.0 };

    Raylib.InitWindow(800, 600, "Raylib Struct FFI Test");
    Raylib.SetWindowMonitor(0)
    Raylib.SetTargetFPS(60);
    while (!Raylib.WindowShouldClose()) {
        Raylib.BeginDrawing();
            Raylib.ClearBackground(BLACK);
            Raylib.DrawRectangleRec(rect, RED);
        Raylib.EndDrawing();
    }
    Raylib.CloseWindow();
}