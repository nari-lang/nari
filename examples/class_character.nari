// Advanced class example: Building a simple game character system

class Character {
    public name: string;
    private health: number = 100;
    private maxHealth: number = 100;
    private level: number = 1;
    private experience: number = 0;

    public init(characterName: string) {
        this.name = characterName;
    }

    public takeDamage(damage: number) {
        this.health = this.health - damage;
        if (this.health < 0) {
            this.health = 0;
        }
        print(this.name @ " took " @ to_string(damage) @ " damage! Health: " @ to_string(this.health));
    }

    public heal(amount: number) {
        this.health = this.health + amount;
        if (this.health > this.maxHealth) {
            this.health = this.maxHealth;
        }
        print(this.name @ " healed " @ to_string(amount) @ " HP! Health: " @ to_string(this.health));
    }

    public gainExperience(xp: number) {
        this.experience = this.experience + xp;
        print(this.name @ " gained " @ to_string(xp) @ " XP!");

        // Level up at 100 XP
        if (this.experience >= 100) {
            this.levelUp();
        }
    }

    private levelUp() {
        this.level = this.level + 1;
        this.experience = this.experience - 100;
        this.maxHealth = this.maxHealth + 20;
        this.health = this.maxHealth;
        print(this.name @ " leveled up to level " @ to_string(this.level) @ "!");
    }

    public getStatus() -> string {
        return this.name @ " [Lv " @ to_string(this.level) @ "] HP: " @
        to_string(this.health) @ "/" @ to_string(this.maxHealth) @
        " XP: " @ to_string(this.experience) @ "/100";
    }

    public isAlive() -> bool {
        return this.health > 0;
    }
}

// Create a character
let hero = new Character("Aria");
print(hero.getStatus());

// Simulate a battle
print("\n--- Battle Begins! ---");
hero.takeDamage(30);
hero.takeDamage(20);
hero.heal(15);

// Gain experience
print("\n--- After Battle ---");
hero.gainExperience(50);
hero.gainExperience(60); // This should trigger level up!

print("\n--- Final Status ---");
print(hero.getStatus());
print("Alive: " @ to_string(hero.isAlive()));
