func outer() {
    let x = 1;
    if (x > 0) {
        print(x);
    } else {
        print(-x);
    }
    while (x < 10) {
        x = x + 1;
    }
}
switch (x) {
    case 1:
        print("one");
        break;
    case 2:
    case 3:
        print("few");
    default:
        print("many");
}
let o = {
    nested: {
        deep: 1
    }
