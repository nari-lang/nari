import { Archive } from "std/archive";

let caught = 0;

// 1. list() on a missing file: libarchive open failure.
try {
    Archive.list("/no/such/archive.tar.gz");
    print("FAIL: list did not throw");
} catch (e) {
    caught = caught + 1;
    print("caught list: " @ to_string(e));
}

// 2. extract() on a missing file.
try {
    Archive.extract("/no/such/archive.tar.gz", "/tmp/__nari_archive_throw_test__");
    print("FAIL: extract did not throw");
} catch (e) {
    caught = caught + 1;
    print("caught extract: " @ to_string(e));
}

// 3. create() with unsupported extension -> our own validation throw.
try {
    Archive.create("/tmp/__nari_archive_throw_test__.bogus", ["/etc/hostname"]);
    print("FAIL: create did not throw");
} catch (e) {
    caught = caught + 1;
    print("caught create: " @ to_string(e));
}

// 4. create() with a non-existent source file.
try {
    Archive.create("/tmp/__nari_archive_throw_test__.tar", ["/no/such/source/file"]);
    print("FAIL: create-missing-src did not throw");
} catch (e) {
    caught = caught + 1;
    print("caught create-missing-src: " @ to_string(e));
}

if (caught == 4) {
    print("OK: all 4 archive errors were script-catchable");
} else {
    throw `expected 4 catches, got {caught}`;
}
