import { assert } from "../lib/assert.nari";

func start() {
    let isIdentifierStart = null;
    let createScanner = null;

    isIdentifierStart = func(ch, languageVersion) {
        return (((ch - 0) >= 65 && (ch - 0) <= 90) ||
                ((ch - 0) >= 97 && (ch - 0) <= 122) ||
                (ch - 0) == 36 || (ch - 0) == 95);
    };
    assert(isIdentifierStart(105, 99), "direct identifier classification failed");

    createScanner = func() {
        let scanIdentifier = null;
        let scan = null;

        scanIdentifier = func(startCharacter, languageVersion) {
            let ch = null;
            ch = startCharacter;
            assert(ch == 105 || ch == 71 || ch == 123, "scanIdentifier lost its parameter");
            assert(ch == 123 || ((ch - 0) >= 65 && (ch - 0) <= 122), "nested numeric range failed");
            let identifierStart = isIdentifierStart(ch, languageVersion);
            assert(ch == 123 || identifierStart, "identifier function failed in scanner closure");
            if (identifierStart) {
                return 80;
            }
            return 0;
        };

        scan = func(value) {
            let ch = null;
            ch = value;
            assert(ch == value, "scan lost its parameter");
            let switchValue = __js_to_number(ch);
            let switchCase = -1;
            if (switchCase < 0 && switchValue == 123) { switchCase = 0; }
            if (switchCase < 0) { switchCase = 1; }
            if (switchCase == 1) {
                return scanIdentifier(ch, 99);
            }
            return 0;
        };

        assert(scan(105) == 80, "lowercase identifier classification failed");
        assert(scan(71) == 80, "uppercase identifier classification failed");
        assert(scan(123) == 0, "switch classification failed");
    };

    createScanner();
    print("closure numeric comparisons passed");
}
