import { assert } from "../lib/assert.nari";

func __js_get_prop(obj, key) {
    if (typeof(obj) == "array" && typeof(key) == "int" && key >= 0 && key < obj.length()) {
        return obj[key];
    }
    return null;
}

func read(obj, key) {
    return __js_get_prop(obj, key);
}

let values = [10, 20];
for (let i = 0; i < 200; i++) {
    assert(read(values, 1) == 20, "array property fast path failed");
    assert(read(values, -1) == null, "negative index skipped fallback");
    assert(read(values, 2) == null, "out-of-bounds index skipped fallback");
    assert(read("text", 0) == null, "non-array receiver skipped fallback");
}

print("JIT JS array property ok");
