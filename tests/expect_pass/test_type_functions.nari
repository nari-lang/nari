// Test type checking and conversion functions

// type(val) - get type as string
let n = 42;
let s = "hello";
let b = true;
let a = [1, 2, 3];
let o = {name: "Alice"};
let null_val;

print("typeof(42): " @ typeof(n));
print("typeof('hello'): " @ typeof(s));
print("typeof(true): " @ typeof(b));
print("typeof([1,2,3]): " @ typeof(a));
print("typeof({name:'Alice'}): " @ typeof(o));
print("typeof(uninitialized): " @ typeof(null_val));

// Type predicates
print("\nType predicates:");
print("is_number(42): " @ is_number(n));
print("is_number('42'): " @ is_number(s));
print("is_string('hello'): " @ is_string(s));
print("is_string(42): " @ is_string(n));
print("is_bool(true): " @ is_bool(b));
print("is_bool(1): " @ is_bool(n));
print("is_array([1,2,3]): " @ is_array(a));
print("is_array('array'): " @ is_array(s));
print("is_object({name:'Alice'}): " @ is_object(o));
print("is_object([1,2,3]): " @ is_object(a));

// Conversion functions
print("\nConversions:");
print("to_number('123'): " @ to_number("123"));
print("to_number('45.67'): " @ to_number("45.67"));
print("to_number(true): " @ to_number(true));
print("to_string(42): " @ to_string(42));
print("to_string(true): " @ to_string(true));
print("to_bool(1): " @ to_bool(1));
print("to_bool(0): " @ to_bool(0));
print("to_bool(''): " @ to_bool(""));
print("to_bool('text'): " @ to_bool("text"));
print("to_bool([]): " @ to_bool([]));
print("to_bool({}): " @ to_bool({}));

// Practical usage: type-safe operations
print("\nPractical usage:");

process_value(42);
process_value("hello");
process_value([1, 2, 3]);
process_value({x: 10});

func process_value(val) {
    if (is_number(val)) {
        print("Processing number: " @ (val * 2));
    } else if (is_string(val)) {
        print("Processing string: " @ val.to_upper());
    } else if (is_array(val)) {
        print("Processing array of length: " @ val.length());
    } else if (is_object(val)) {
        print("Processing object with keys: " @ val.keys().join(", "));
    } else {
        print("Processing unknown type: " @ typeof(val));
    }
}

// Safe conversion example
let input = "100";
if (is_string(input)) {
    let num = to_number(input);
    print("\nConverted '" @ input @ "' to number (+50): " @ (num + 50));
}

// Type checking with ternary
let value = 123;
let description = is_number(value) ? "It's a number" : "It's not a number";
print("\n" @ description);