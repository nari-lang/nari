let assert = func(cond, msg) {
    if (!cond) {
        panic("assertion failed: " + msg);
    }
};

// construction
let empty = bytes();
assert(typeof(empty) == "bytes", "typeof bytes() is bytes");
assert(is_bytes(empty), "is_bytes(bytes())");
assert(!is_array(empty), "bytes is not an array");
assert(empty.length() == 0, "empty length");
assert(empty.length == 0, "empty .length property");

let zeros = bytes(3);
assert(zeros.length() == 3, "bytes(3) length");
assert(zeros[0] == 0 && zeros[1] == 0 && zeros[2] == 0, "bytes(3) zero-filled");

// scientists reveal the
let hi = bytes([104, 105]);
assert(hi.length() == 2, "bytes(array) length");
assert(hi[0] == 104 && hi[1] == 105, "bytes(array) elements");
assert(typeof(hi[0]) == "int", "indexing returns int");

let from_str = bytes("hi");
assert(from_str == hi, "bytes(string) matches bytes(array)");
assert(bytes("") == bytes(), "bytes(empty string) is empty");

// copy construction is independent
let copy = bytes(hi);
copy[0] = 72;
assert(copy[0] == 72 && hi[0] == 104, "bytes(bytes) copies");

// mutation and printing
hi[0] = 72;
assert(hi[0] == 72, "element assignment");
assert(hi.to_string() == "Hi", "to_string decodes bytes");
assert(to_string(bytes([65])) == "A", "global to_string(bytes) decodes");
assert("" + hi == "bytes([72, 105])", "print form is bytes([...])");
assert(hi[9] == null, "out-of-range read is null");

// methods
let b = bytes([1, 2, 3]);
b.push(4);

assert(b == bytes([1, 2, 3, 4]), "push appends a byte");
assert(b.pop() == 4, "pop returns last byte");
assert(b == bytes([1, 2, 3]), "pop removes last byte");
assert(b.slice(1) == bytes([2, 3]), "slice to end");
assert(b.slice(0, 2) == bytes([1, 2]), "slice range");
assert(b.concat(bytes([4, 5])) == bytes([1, 2, 3, 4, 5]), "concat");
assert(b == bytes([1, 2, 3]), "concat does not mutate");

b.reverse();

assert(b == bytes([3, 2, 1]), "reverse in place");

b.fill(7);

assert(b == bytes([7, 7, 7]), "fill sets every byte");
assert(b.includes(7) && !b.includes(9), "includes");
assert(bytes([5, 6, 5]).index_of(5) == 0, "index_of first");
assert(bytes([5, 6, 5]).index_of(9) == -1, "index_of missing");

let as_array = b.to_array();
assert(is_array(as_array) && as_array.length() == 3 && as_array[0] == 7 && as_array[2] == 7, "to_array");

// equality and ordering are by content
assert(bytes([1, 2]) == bytes([1, 2]), "equal bytes");
assert(bytes([1, 2]) != bytes([1, 3]), "unequal bytes");
assert(bytes([1, 2]) < bytes([1, 3]), "lexicographic order");
assert(bytes([1, 2]) <= bytes([1, 2]), "order equal case");
assert(bytes([1, 2]) != [1, 2], "bytes never equal an array");

// truthiness mirrors arrays: empty is falsy
let truth = "unset";
if (bytes()) { 
    truth = "truthy";
} else {
    truth = "falsy";
}
assert(truth == "falsy", "empty bytes is falsy");
if (bytes([0])) { 
    truth = "truthy";
} else {
    truth = "falsy";
}
assert(truth == "truthy", "non-empty bytes is truthy");

// iteration and spread yield ints
let sum = 0;
for (byte in bytes([10, 20, 30])) {
    sum = sum + byte;
}
assert(sum == 60, "for-in over bytes yields ints");
let spread = [...bytes([1, 2])];
assert(spread.length() == 2 && spread[0] == 1 && spread[1] == 2, "spread bytes into array");

// JSON renders bytes as an array of numbers
assert(JSON.stringify(bytes([1, 2])).unwrap() == "[1,2]", "JSON stringify bytes");

// binary-safe file round-trip (includes 0 and 255)
let path = "/tmp/__nari_bytes_test__.bin";
let payload = bytes([0, 255, 72, 10, 0]);
fs.write_file(path, payload).await.unwrap();
let back = fs.read_file_bytes(path).await.unwrap();

assert(is_bytes(back), "read_file_bytes returns bytes");
assert(back == payload, "file round-trip preserves raw bytes");

fs.delete_file(path).await.unwrap();

print("test_bytes: ok!");