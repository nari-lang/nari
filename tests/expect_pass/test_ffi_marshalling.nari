let libc_name = "libc.so.6"
if (platform.os == "macos") {
    libc_name = "libSystem.B.dylib"
} else if (platform.os == "windows") {
    libc_name = "msvcrt.dll"
}
let libc = __ffi_load_library(libc_name)

let parsed = __ffi_call(libc, "strtod", {
    returns: "double",
    params: ["string", "pointer"]
}, ["12.5", 0])
if (parsed != 12.5) {
    panic("fixed FFI scalar marshalling failed")
}

let written = __ffi_call(libc, "printf", {
    returns: "int",
    params: ["string"],
    variadic: true
}, ["ffi variadic marshalling: %d %.1f %s\n", 42, 2.5, "ok"])
if (written <= 0) {
    panic("variadic FFI scalar marshalling failed")
}

print("ffi marshalling test passed")
