import a from "../dep/module_collision_a.nari";
import b from "../dep/module_collision_b.nari";
import { describe as describe_a } from "../dep/module_collision_a.nari";
import { describe as describe_b } from "../dep/module_collision_b.nari";

if (a.describe() != "module-a") {
    panic("namespace import returned wrong function for module a");
}

if (b.describe() != "module-b") {
    panic("namespace import returned wrong function for module b");
}

if (describe_a() != "module-a") {
    panic("named import alias returned wrong function for module a");
}

if (describe_b() != "module-b") {
    panic("named import alias returned wrong function for module b");
}

print("success!");