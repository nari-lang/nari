// 1. Basic Function Expression Patterns
print("Basic Function Expressions");

let basic_funcs = {
    square: func(x) { return x * x; },
    cube: func(x) { return x * x * x; },
    greet: func(name) { return "Hello, " @ name @ "!"; }
};

print("square(5): " @ basic_funcs.square(5));
print("cube(3): " @ basic_funcs.cube(3));
print(basic_funcs.greet("Function"));

// Function expression in variable assignment
let multiply_by_3 = func(n) { return n * 3; };
print("multiply_by_3(7): " @ multiply_by_3(7));

// 2. Higher-Order Functions
print("Higher-Order Functions");

func apply_operation(op, x, y) {
    return op(x, y);
}

let operations = {
    add: func(a, b) { return a + b; },
    subtract: func(a, b) { return a - b; },
    multiply: func(a, b) { return a * b; }
};

print("apply_operation(add, 8, 3): " @ apply_operation(operations.add, 8, 3));
print("apply_operation(multiply, 4, 5): " @ apply_operation(operations.multiply, 4, 5));

// Function that returns a function
func make_operation(op_name) {
    if (op_name == "add") {
        return func(a, b) { return a + b; };
    }
    if (op_name == "multiply") {
        return func(a, b) { return a * b; };
    }
    return func(a, b) { return 0; };
}

let dynamic_add = make_operation("add");
let dynamic_multiply = make_operation("multiply");
print("dynamic_add(6, 4): " @ dynamic_add(6, 4));
print("dynamic_multiply(3, 7): " @ dynamic_multiply(3, 7));

// 3. Closure Patterns
print("Closure Patterns");

// Counter closure
func create_counter(initial, step) {
    let count = initial;
    let increment = step;
    
    return {
        next: func() {
            count = count + increment;
            return count;
        },
        reset: func() {
            count = initial;
            return count;
        },
        current: func() {
            return count;
        },
        set_step: func(new_step) {
            increment = new_step;
        }
    };
}

print("Counter Test:");
let counter = create_counter(10, 5);
print("Initial: " @ counter.current());
print("Next: " @ counter.next());
print("Next: " @ counter.next());
counter.set_step(2);
print("Next (step=2): " @ counter.next());
print("Reset: " @ counter.reset());

// Bank account closure
func create_account(initial_balance) {
    let balance = initial_balance;
    let transaction_count = 0;
    
    return {
        deposit: func(amount) {
            balance = balance + amount;
            transaction_count = transaction_count + 1;
            return balance;
        },
        withdraw: func(amount) {
            if (amount <= balance) {
                balance = balance - amount;
                transaction_count = transaction_count + 1;
                return balance;
            }
            return balance;  // Insufficient funds
        },
        get_balance: func() {
            return balance;
        },
        get_transaction_count: func() {
            return transaction_count;
        }
    };
}

print("Bank Account Test:");
let account = create_account(100);
print("Initial balance: " @ account.get_balance());
print("After deposit(50): " @ account.deposit(50));
print("After withdraw(25): " @ account.withdraw(25));
print("Transaction count: " @ account.get_transaction_count());

// 4. Advanced Closure Patterns
print("Advanced Patterns");

// Function factory with multiple closures
func create_math_utilities(precision) {
    let decimal_places = precision;
    
    return {
        make_rounder: func() {
            return func(number) {
                // Simple rounding simulation (since we don't have proper math functions)
                return number;  // Simplified for this test
            };
        },
        
        make_calculator: func() {
            let memory = 0;
            
            return {
                add: func(n) {
                    memory = memory + n;
                    return memory;
                },
                subtract: func(n) {
                    memory = memory - n;  
                    return memory;
                },
                clear: func() {
                    memory = 0;
                    return memory;
                },
                recall: func() {
                    return memory;
                }
            };
        },
        
        get_precision: func() {
            return decimal_places;
        }
    };
}

let math_utils = create_math_utilities(2);
let calc1 = math_utils.make_calculator();
let calc2 = math_utils.make_calculator();

print("Calculator 1 test:");
print("calc1.add(10): " @ calc1.add(10));
print("calc1.add(5): " @ calc1.add(5));
print("calc1.subtract(3): " @ calc1.subtract(3));

print("Calculator 2 test (independent):");
print("calc2.add(100): " @ calc2.add(100));
print("calc1.recall(): " @ calc1.recall());  // Should be 12
print("calc2.recall(): " @ calc2.recall());  // Should be 100

// 5. Complex Nested Closures
print("Complex Nested Closures");

// Nested closure with multiple levels
func create_nested_closure(outer_value) {
    let outer = outer_value;
    
    return func(middle_value) {
        let middle = middle_value;
        
        return func(inner_value) {
            return outer + middle + inner_value;
        };
    };
}

let nested = create_nested_closure(100);
let middle_func = nested(20);
print("Nested closure test:");
print("nested(100)(20)(3): " @ middle_func(3));  // Should be 123

// Function composition with closures
func compose_functions(f1, f2) {
    return func(x) {
        return f1(f2(x));
    };
}

let double = func(n) { return n * 2; };
let add_five = func(n) { return n + 5; };
let double_then_add_five = compose_functions(add_five, double);
let add_five_then_double = compose_functions(double, add_five);

print("Function composition test:");
print("double_then_add_five(10): " @ double_then_add_five(10));  // (10*2)+5 = 25
print("add_five_then_double(10): " @ add_five_then_double(10));  // (10+5)*2 = 30

// 6. Array of Closures
print("Array of Closures");

// Create array of functions that multiply by different factors
let multiplier_funcs = [
    func(n) { return n * 1; },
    func(n) { return n * 2; },
    func(n) { return n * 3; },
    func(n) { return n * 4; },
    func(n) { return n * 5; }
];

print("Multiplier functions test:");
print("multiplier_funcs[0](10): " @ multiplier_funcs[0](10));  // 10 * 1 = 10
print("multiplier_funcs[2](10): " @ multiplier_funcs[2](10));  // 10 * 3 = 30
print("multiplier_funcs[4](10): " @ multiplier_funcs[4](10));  // 10 * 5 = 50

// Closure-based array generation
func make_multiplier_for(factor) {
    return func(n) {
        return n * factor;
    };
}

let generated_multipliers = [
    make_multiplier_for(2),
    make_multiplier_for(3),
    make_multiplier_for(4)
];

print("Generated multipliers test:");
print("2x multiplier(7): " @ generated_multipliers[0](7));  // 14
print("3x multiplier(7): " @ generated_multipliers[1](7));  // 21
print("4x multiplier(7): " @ generated_multipliers[2](7));  // 28