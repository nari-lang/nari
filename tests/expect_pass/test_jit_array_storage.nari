import { assert } from "../lib/assert.nari";

func exercise_array(seed) {
    let values = [];
    values.push(seed);
    values.push(seed + 1);
    values.push(seed + 2);
    values.push(seed + 3);
    values.push(seed + 4);
    values[1] = values[4] + 10;
    return values[0] + values[1] + values[2] + values[3] + values[4];
}

func exercise_index_semantics(seed) {
    let values = [seed, seed + 1];
    let text = "ab";
    let whole_float = 1.0 - 1.0;
    if (values[whole_float] != seed) panic("whole-float array read failed");
    if (values[-1] != null) panic("negative array read used from-end semantics");
    if (text[-1] != null) panic("negative string read used from-end semantics");
}

let result = 0;
for (let i = 0; i < 200; i++) {
    result = exercise_array(i);
    exercise_index_semantics(i);
}

assert(result == 1018, "JIT array push/index result was " @ result);
print("JIT array storage ok");
