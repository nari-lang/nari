// Test to verify GC doesn't hold unnecessary references
// The collector should reclaim unreachable objects without keeping stale roots.

print("GC Memory Behavior Test\n");

// Test 1: Non-circular allocations should be collectable.
print("[Test 1] Non-circular allocations (collectable)");
let before1 = __gc_stats();

for (let i = 0; i < 1000; i = i + 1) {
    let temp = { id: i, data: [1, 2, 3] };
    // temp goes out of scope and should be collectable.
}

let after1 = __gc_stats();
print("  Allocated: 1000+");
print("  Still tracked: " @ after1.tracked);
print("  Note: If tracked is low, unreachable objects were collected (GOOD)");

// Test 2: Circular references need GC.
print("\n[Test 2] Circular references (need GC collection)");
let before2 = __gc_stats();

for (let i = 0; i < 100; i = i + 1) {
    let obj1 = { id: i };
    let obj2 = { ref: obj1 };
    obj1.ref = obj2;  // Circular reference
    // Now out of scope; only the collector can reclaim the cycle.
}

let after2 = __gc_stats();
print("  Created: 200 objects in 100 cycles");
print("  Before GC tracked: " @ after2.tracked);

// Force collection
let collectResult = __gc_collect();
print("  Circular refs collected: " @ collectResult.collected);
print("  After GC tracked: " @ collectResult.tracked);

// Test 3: Memory behavior comparison
print("\n[Test 3] GC vs non-GC allocations");

// Create short-lived acyclic objects.
let stats3a = __gc_stats();
for (let i = 0; i < 5000; i = i + 1) {
    let temp = [i, i+1, i+2];
}
let stats3b = __gc_stats();
let autoFreed = stats3b.tracked - stats3a.tracked;

print("  After 5000 non-circular allocations:");
print("  Tracked increase: " @ autoFreed);
print("  Expected: low after safe-point collection");

// Create circular references
let stats3c = __gc_stats();
for (let i = 0; i < 100; i = i + 1) {
    let arr = [];
    arr.push(arr);  // Self-reference
}
let stats3d = __gc_stats();
let cycleIncrease = stats3d.tracked - stats3c.tracked;

print("\n  After 100 circular allocations:");
print("  Tracked increase: " @ cycleIncrease);
print("  Expected: ~100 (cycles need GC)");

// Collect cycles
let final = __gc_collect();
print("\n  After GC collection:");
print("  Cycles collected: " @ final.collected);

print("\ntest complete!");
