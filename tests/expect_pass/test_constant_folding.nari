func start() {
    print("Constant folding");
    let a = 2 + 3 * 4;
    let b = (10 - 3) * 2;
    let c = "hello" @ " " @ "world";
    let d = (true ? 5 : 9) + 1;
    let e = (1 + 2) == 3;
    print("a=" @ toString(a));
    print("b=" @ toString(b));
    print("c=" @ c);
    print("d=" @ toString(d));
    print("e=" @ toString(e));
}
