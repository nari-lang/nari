func start() {
    print("Constant folding");
    let a = 2 + 3 * 4;
    let b = (10 - 3) * 2;
    let c = "hello" @ " " @ "world";
    let d = (true ? 5 : 9) + 1;
    let e = (1 + 2) == 3;
    print("a=" @ to_string(a));
    print("b=" @ to_string(b));
    print("c=" @ c);
    print("d=" @ to_string(d));
    print("e=" @ to_string(e));
}
