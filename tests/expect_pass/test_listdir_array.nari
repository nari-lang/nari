// Demonstrate that listDir now returns proper arrays
system.print("Testing listDir Array Return\n");

// Get files in tests directory
let files = Spawn.await(io.listDir("tests"));

system.print("Type check:");
system.print("\ttypeof(files) = " @ typeof(files));
system.print("\tIs array? " @ (typeof(files) == "array"));
system.print("");

system.print("Array operations now work directly:");
system.print("\tFiles found: " @ files.length());
system.print("");

system.print("Can iterate with for-each:");
for (file in files) {
    system.print("\t- " @ file);
}
system.print("");

system.print("Can use array methods:");
system.print("\tFirst: " @ files[0]);
if (files.length() > 1) {
    system.print("\tLast:  " @ files[files.length() - 1]);
}
system.print("");
