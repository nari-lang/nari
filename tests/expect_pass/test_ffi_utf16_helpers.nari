let p1 = __ffi_utf16("hello")
if (p1 == 0) {
    throw("__ffi_utf16 returned null for ascii input")
}
__ffi_free(p1)

let p2 = __ffi_utf16("Hello 👋 Привет こんにちは")
if (p2 == 0) {
    throw("__ffi_utf16 returned null for unicode input")
}
__ffi_free(p2)

let p3 = __ffi_utf16("")
if (p3 == 0) {
    throw("__ffi_utf16 returned null for empty string")
}
__ffi_free(p3)

print("ffi utf16 helper test passed")
