import { Archive } from "std/archive";

let errs = 0;

// 1. list() on a missing file: libarchive open failure -> Err.
let r1 = Archive.list("/no/such/archive.tar.gz");
if (r1.is_err()) {
    errs = errs + 1;
    print("err list: " @ to_string(r1.unwrap_err()));
} else {
    print("FAIL: list did not return Err");
}

// 2. extract() on a missing file -> Err.
let r2 = Archive.extract("/no/such/archive.tar.gz", "/tmp/__nari_archive_err_test__");
if (r2.is_err()) {
    errs = errs + 1;
    print("err extract: " @ to_string(r2.unwrap_err()));
} else {
    print("FAIL: extract did not return Err");
}

// 3. create() with unsupported extension -> our own validation Err.
let r3 = Archive.create("/tmp/__nari_archive_err_test__.bogus", ["/etc/hostname"]);
if (r3.is_err()) {
    errs = errs + 1;
    print("err create: " @ to_string(r3.unwrap_err()));
} else {
    print("FAIL: create did not return Err");
}

// 4. create() with a non-existent source file -> Err.
let r4 = Archive.create("/tmp/__nari_archive_err_test__.tar", ["/no/such/source/file"]);
if (r4.is_err()) {
    errs = errs + 1;
    print("err create-missing-src: " @ to_string(r4.unwrap_err()));
} else {
    print("FAIL: create-missing-src did not return Err");
}

if (errs == 4) {
    print("OK: all 4 archive errors returned Err");
} else {
    panic(`expected 4 errors, got {errs}`);
}
