fs.write_file("__test_temp__.txt", "test content").await
let content = fs.read_file("__test_temp__.txt")
    .await
    .unwrap()

if (content == "test content") {
    system.print("Read/write successful")
} else {
    system.print("Read/write failed")
    panic(`Read/write failed: got {content}`);
}

fs.append_file("__test_temp__.txt", " appended").await
let appended = fs.read_file("__test_temp__.txt")
    .await
    .unwrap()

if (appended == "test content appended") {
    system.print("Append successful")
} else {
    system.print("Append failed: got " @ appended)
    panic(`Append failed: got {appended}`);
}

let exists = fs.file_exists("__test_temp__.txt")
    .await

if (exists) {
    system.print("File exists check successful")
} else {
    system.print("File exists check failed");
    panic("File should exist");
}

let files = fs.list_dir(".")
    .await
    .unwrap()

if (files.length() > 0) {
    system.print("List directory successful")
} else {
    system.print("List directory failed")
}

fs.delete_file("__test_temp__.txt").await
let stillExists = fs.file_exists("__test_temp__.txt")
    .await

if (!stillExists) {
    system.print("Delete successful")
} else {
    system.print("Delete failed")
}

system.print("All I/O tests passed!")
