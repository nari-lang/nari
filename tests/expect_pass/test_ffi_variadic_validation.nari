let libc_name = "libc.so.6"
if (platform.os == "macos") {
    libc_name = "libSystem.B.dylib"
} else if (platform.os == "windows") {
    libc_name = "msvcrt.dll"
}
let libc = __ffi_load_library(libc_name)

let negative = __ffi_call(libc, "printf", {
    returns: "int",
    params: [],
    variadic: -1
}, [])
if (negative != null) {
    panic("negative variadic fixed count was accepted")
}

let excessive = __ffi_call(libc, "printf", {
    returns: "int",
    params: [],
    variadic: 1
}, [])
if (excessive != null) {
    panic("excessive variadic fixed count was accepted")
}

let object_arg = __ffi_call(libc, "printf", {
    returns: "int",
    params: ["string"],
    variadic: true
}, ["", {}])
if (object_arg != null) {
    panic("inferred variadic object argument was accepted")
}

let array_arg = __ffi_call(libc, "printf", {
    returns: "int",
    params: ["string"],
    variadic: true
}, ["", []])
if (array_arg != null) {
    panic("inferred variadic array argument was accepted")
}

print("ffi variadic validation test passed")
