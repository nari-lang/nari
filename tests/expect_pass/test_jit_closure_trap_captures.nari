// Regression test: a JIT-compiled closure invoked via call_function_value_sync
// (delegate traps, array higher-order callbacks, timers, FFI callbacks) must
// read its captured variables correctly.

func assert(cond, msg) {
    if (!cond) { panic(msg); }
}

// Delegate get/set traps capturing a local
func delegate_capture_sum(n, secret) {
    let store = {}
    let d = Delegate(store, {
        // captures `secret` (a local), not a global
        get: func(t, k) { let v = t[k]; if (v == null) { return secret } return v },
        set: func(t, k, v) { t[k] = v + secret }
    })
    let cs = 0
    for (let i = 0; i < n; i++) {
        d["x"] = i          // stored as i + secret
        cs = cs + d["x"]    // reads back i + secret
    }
    return cs
}

// --- Nested delegates: outer trap re-enters inner (captures `inner`) -----
func nested_delegate_sum(n) {
    let inner = Delegate({"x": 42}, {
        get: func(t, k) { let v = t[k]; if (v == null) { return -1 } return v }
    })
    let outer = Delegate({}, {
        get: func(t, k) { return inner[k] }   // captures `inner`
    })
    let cs = 0
    for (let i = 0; i < n; i++) { cs = cs + outer["x"] }
    return cs
}

// Delegate call/has fast paths preserve observable arguments
let call_args = []
let call_handler = {
    call: func(t, args) {
        call_args.push(args)
        return t + args[0] + args[1]
    },
    has: func(t, key) { return key == "present" }
}
let callable = Delegate(10, call_handler)
assert(callable(2, 3) == 15, "delegate call forwards all arguments")
assert(callable(4, 5) == 19, "delegate call remains reusable")
assert(call_args.length() == 2 && call_args[0] != call_args[1], "delegate call creates a fresh argument array")
assert(call_args[0][0] == 2 && call_args[1][1] == 5, "retained delegate argument arrays keep independent values")
assert(callable.has_key("present") && !callable.has_key("missing"), "delegate has_key routes through the has trap")
call_handler.call = func(t, args) { return args.length() }
assert(callable(1, 2, 3) == 3, "replacing a call trap takes effect immediately")

let forwarded = Delegate(callable, {})
assert(forwarded(7, 8, 9, 10) == 4, "chained delegates forward pointer/count arguments")

// Trap slot cache: handler shape transitions and dict-mode handlers
// The trap dispatcher caches (shape, slot) per delegate, these cover the
// invalidation edges: a trap ADDED after first dispatch
// and a handler promoted to dict mode (>32 fields) before/after first use.
let grow_store = {}
let grow_handler = { get: func(t, k) { let v = t[k]; if (v == null) { return -7 } return v } }
let gd = Delegate(grow_store, grow_handler)
assert(gd["x"] == -7, "get trap active before handler grows")
gd["x"] = 5 // no set trap yet -> default set on target
assert(gd["x"] == 5, "default set stored on target")
grow_handler.set = func(t, k, v) { t[k] = v + 100 } // new field: handler shape changes
gd["x"] = 5
assert(gd["x"] == 105, "set trap added after first dispatch is picked up")

let promo_handler = { get: func(t, k) { return 88 } }
let pd = Delegate({}, promo_handler)
assert(pd["k"] == 88, "get trap before handler promotes to dict mode")
for (let i = 0; i < 40; i++) { promo_handler["p" @ to_string(i)] = i }
assert(pd["k"] == 88, "get trap after handler promotes to dict mode")

let big_handler = { get: func(t, k) { return 77 } }
for (let i = 0; i < 40; i++) { big_handler["q" @ to_string(i)] = i }
let bd = Delegate({}, big_handler)
assert(bd["whatever"] == 77, "dict-mode handler dispatches get trap")

// Array higher-order callback capturing a local
func reduce_capture(n, base) {
    let arr = [1, 2, 3, 4, 5]   // sum 15; + base per element
    let total = 0
    for (let i = 0; i < n; i++) {
        total = total + arr.reduce(func(acc, x) { return acc + x + base }, 0)
    }
    return total
}

let N = 2000

// delegate_capture_sum: set stores (i + secret); get returns that stored value
// (the key exists), so each iter adds (i + secret); secret=10.
// sum_{i=0}^{N-1}(i + secret) = N*(N-1)/2 + N*secret
let expect_deleg = (N * (N - 1)) / 2 + N * 10
assert(delegate_capture_sum(N, 10) == expect_deleg,
    "delegate capture: got " @ delegate_capture_sum(N, 10) @ " want " @ expect_deleg)

// nested: each iter adds 42
assert(nested_delegate_sum(N) == N * 42,
    "nested delegate: got " @ nested_delegate_sum(N) @ " want " @ (N * 42))

// reduce: each call = 15 + base*5 = 15 + 50 = 65
assert(reduce_capture(N, 10) == N * 65,
    "reduce capture: got " @ reduce_capture(N, 10) @ " want " @ (N * 65))

print("test_jit_closure_trap_captures: ok")
