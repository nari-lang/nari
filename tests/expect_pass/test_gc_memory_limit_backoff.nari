// a memory limit BELOW the live heap must not make every allocation run a full mark-and-sweep.

print("GC memory-limit backoff test\n");

// Hold everything live so no collection can ever reclaim anything.
let live = [];

// 1 byte: unsatisfiable by construction, every allocation is over the limit.
__gc_set_memory_limit(1);

let before = __gc_stats().totalCollections;

let N = 3000;
for (let i = 0; i < N; i = i + 1) {
    live.push({ id: i, data: [i, i + 1, i + 2] });
}

let after = __gc_stats().totalCollections;
let collections = after - before;

__gc_set_memory_limit(0);

print("  live objects retained: " @ live.length);
print("  collections during " @ N @ " live allocations: " @ collections);

// Nothing is collectable, so the count must stay tiny. Pre-fix this tracked the
// allocation count (thousands); the doubling backoff keeps it logarithmic.
if (live.length != N) {
    print("FAIL: expected " @ N @ " live objects, got " @ live.length);
    __process_exit(1);
}
if (collections > 64) {
    print("FAIL: " @ collections @ " collections for " @ N @ " live allocations");
    print("      memory-limit heuristic is not backing off past the live heap");
    __process_exit(1);
}

print("\nPASS: memory limit backs off past the live heap");
