let plain = to_string("hello");
if (plain != "hello") {
    throw "Expected plain string to_string to be unquoted, got: " @ plain;
}

let obj = to_string({msg: "hello"});
if (obj != "{msg: \"hello\"}") {
    throw "Expected object-context string value to be quoted, got: " @ obj;
}

let arr = to_string(["x"]);
if (arr != "[\"x\"]") {
    throw "Expected array-context string value to be quoted, got: " @ arr;
}

print("string context to_string test passed");
