// Test destructuring assignments

// Array destructuring
let arr = [1, 2, 3, 4, 5];
let [a, b, c] = arr;
print("Array destructuring:\n");
print("a = " @ a @ "\n");
print("b = " @ b @ "\n");
print("c = " @ c @ "\n");

// Array destructuring with fewer variables than elements
let numbers = [10, 20, 30, 40];
let [first, second] = numbers;
print("\nPartial array destructuring:\n");
print("first = " @ first @ "\n");
print("second = " @ second @ "\n");

// Array destructuring with more variables than elements
let short = [100, 200];
let [x, y, z] = short;
print("\nArray destructuring with missing elements:\n");
print("x = " @ x @ "\n");
print("y = " @ y @ "\n");
print("z = " @ z @ " (should be null)\n");

// Object destructuring
let person = { name: "Alice", age: 30, city: "New York" };
let {name, age} = person;
print("\nObject destructuring:\n");
print("name = " @ name @ "\n");
print("age = " @ age @ "\n");

// Object destructuring with different variable names
let coords = { x: 100, y: 200 };
let {x: posX, y: posY} = coords;
print("\nObject destructuring with rename:\n");
print("posX = " @ posX @ "\n");
print("posY = " @ posY @ "\n");

// Object destructuring with missing properties
let partial = { foo: "bar" };
let {foo, baz} = partial;
print("\nObject destructuring with missing property:\n");
print("foo = " @ foo @ "\n");
print("baz = " @ baz @ " (should be null)\n");

// Nested arrays
let matrix = [[1, 2], [3, 4], [5, 6]];
let [row1, row2] = matrix;
print("\nNested array destructuring:\n");
print("row1 = [" @ row1[0] @ ", " @ row1[1] @ "]\n");
print("row2 = [" @ row2[0] @ ", " @ row2[1] @ "]\n");

// Function returning array
func getCoordinates() {
    return [42, 84];
}
let [coordX, coordY] = getCoordinates();
print("\nDestructuring function return:\n");
print("coordX = " @ coordX @ "\n");
print("coordY = " @ coordY @ "\n");

// Function returning object
func getUserInfo() {
    return { username: "bob123", email: "bob@example.com" };
}
let {username, email} = getUserInfo();
print("\nDestructuring object return:\n");
print("username = " @ username @ "\n");
print("email = " @ email @ "\n");

// Mixed destructuring in loops
let users = [
    { name: "User1", score: 100 },
    { name: "User2", score: 200 },
    { name: "User3", score: 150 }
];

print("\nDestructuring in data processing:\n");
for (user in users) {
    print(user.name @ ": " @ user.score @ " points\n");
}

// Global destructuring
global [globalA, globalB] = [999, 888];
print("\nGlobal array destructuring:\n");
print("globalA = " @ globalA @ "\n");
print("globalB = " @ globalB @ "\n");

global {alpha, beta} = {alpha: "A", beta: "B"};
print("\nGlobal object destructuring:\n");
print("alpha = " @ alpha @ "\n");
print("beta = " @ beta @ "\n");

print("\nAll destructuring tests passed!\n");
