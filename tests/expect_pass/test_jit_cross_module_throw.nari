// Regression: a `throw` inside an imported-module function, called from a
// JIT-compiled call site, must be catchable by the importing module's
// try/catch. Prior to the fix, the JIT call helpers (jit_call_jit,
// jit_call_func, jit_call_value, jit_call_method) returned normally to their
// JIT-emitted callers after dispatch_throw unwound past them, leaving the
// outer JIT code executing with stale frame state. Symptom: the throw
// payload was silently dropped and a downstream operation tripped a runtime
// type error like "TypeError: 'index_of' can only be called on a string".
//
// The fix: after dispatch_throw, longjmp out to VM::run via overflow_jmp_
// when jit_call_depth > 0 (and unconditionally from jit_throw, which only
// runs from JIT).
//
// We exercise three call shapes and run each many times so the JIT trace
// recorder hot-compiles the call site. Counters live in a mutable array so
// inner functions can update them without the global-write-shadowing issue.

import { throw_simple, throw_via_helper, throw_after_loop } from "../dep/module_throws.nari";

// [caught, failed]
let counters = [0, 0];

func bump_caught() { counters[0] = counters[0] + 1; }
func bump_failed(msg) {
    counters[1] = counters[1] + 1;
    print("FAIL: " @ msg);
}

func exercise_simple() {
    let i = 0;
    while (i < 200) {
        try {
            throw_simple();
            bump_failed("throw_simple did not throw");
        } catch (e) {
            if (to_string(e) == "ERR_SIMPLE") {
                bump_caught();
            } else {
                bump_failed("wrong payload from throw_simple: " @ to_string(e));
            }
        }
        i = i + 1;
    }
}

func exercise_nested() {
    let i = 0;
    while (i < 200) {
        try {
            throw_via_helper();
            bump_failed("throw_via_helper did not throw");
        } catch (e) {
            if (to_string(e) == "ERR_NESTED") {
                bump_caught();
            } else {
                bump_failed("wrong payload from throw_via_helper: " @ to_string(e));
            }
        }
        i = i + 1;
    }
}

func exercise_after_loop() {
    let i = 0;
    while (i < 200) {
        try {
            throw_after_loop(5);
            bump_failed("throw_after_loop did not throw");
        } catch (e) {
            // sum 0..4 = 10
            if (to_string(e) == "ERR_AFTER_LOOP:10") {
                bump_caught();
            } else {
                bump_failed("wrong payload from throw_after_loop: " @ to_string(e));
            }
        }
        i = i + 1;
    }
}

exercise_simple();
exercise_nested();
exercise_after_loop();

let caught = counters[0];
let failed = counters[1];
if (caught == 600 && failed == 0) {
    print("OK: 600 cross-module throws caught under JIT");
} else {
    throw `expected 600 catches / 0 failures, got caught={caught} failed={failed}`;
}
