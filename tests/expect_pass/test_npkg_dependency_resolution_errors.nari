import Store from "../../workspace/npkg/lib/store.nari";

func assert_contains(text, needle, label) {
    if (text.index_of(needle) == -1) {
        throw label @ ": expected error to contain '" @ needle @ "' but got '" @ text @ "'";
    }
}

func expect_error(project_root, checks) {
    let got_error = false;

    try {
        Store.resolve_project(project_root);
    } catch (err) {
        got_error = true;
        for (needle in checks) {
            assert_contains(err, needle, project_root);
        }
    }

    if (!got_error) {
        throw "Expected dependency resolution to fail for " @ project_root;
    }
}

expect_error(
    "tests/dep/naripm_missing_path_root",
    [
        "Could not resolve path dependency 'fixture_missing_local'",
        "tests/dep/naripm_missing_path_root/nari.toml",
        "tests/dep/naripm_missing_path_root/does-not-exist",
    ]
);

expect_error(
    "tests/dep/naripm_missing_manifest_root",
    [
        "Could not resolve path dependency 'fixture_missing_manifest'",
        "tests/dep/naripm_missing_manifest_root/nari.toml",
        "tests/dep/naripm_missing_manifest_root/vendor/libfoo/nari.toml",
    ]
);

print("success!");