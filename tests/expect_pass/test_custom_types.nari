// Define a simple Score type
type Score {
    name: string;
    score: number
}

// Define a Player type with more fields
type Player {
    id: number;
    username: string;
    level: number;
    inventory: string[]
}

// Function using custom type annotation
func is_high_score(score: Score) -> bool {
    return score.score > 100;
}

// Function creating a Score object
func create_score(player_name: string, points: number) -> Score {
    return {
        name: player_name,
        score: points
    };
}

// Function using Player type
func get_player_info(player: Player) -> string {
    return player.username @ " (Level " @ toString(player.level) @ ")";
}

// Function creating a Player object
func create_player(id: number, username: string) -> Player {
    return {
        id: id,
        username: username,
        level: 1,
        inventory: []
    };
}

// Array of custom types
func get_top_scores(scores: Score[]) -> Score[] {
    let top = [];
    for (s in scores) {
        if (is_high_score(s)) {
            top.push(s);
        }
    }
    return top;
}

func start() {
    print("Custom Type System Tests");
    
    // Create some score objects
    let score1 = create_score("Alice", 150);
    let score2 = create_score("Bob", 75);
    let score3 = create_score("Charlie", 200);
    
    print("Score 1: " @ score1.name @ " - " @ toString(score1.score));
    print("Is high score? " @ toString(is_high_score(score1)));
    
    print("Score 2: " @ score2.name @ " - " @ toString(score2.score));
    print("Is high score? " @ toString(is_high_score(score2)));
    
    // Test array of custom types
    let all_scores = [score1, score2, score3];
    let high_scores = get_top_scores(all_scores);
    
    print("High scores count: " @ toString(high_scores.length()));
    for (s in high_scores) {
        print("  " @ s.name @ ": " @ toString(s.score));
    }
    
    // Test Player type
    let player1 = create_player(1, "PlayerOne");
    let player2 = create_player(2, "PlayerTwo");
    
    print("Player info: " @ get_player_info(player1));
    print("Player info: " @ get_player_info(player2));
    
    // Modify player
    player1.level = 5;
    player1.inventory = ["sword", "shield", "potion"];
    
    print("Updated player level: " @ toString(player1.level));
    print("Inventory items: " @ toString(player1.inventory.length()));
    
    print("Tests Complete");
}
