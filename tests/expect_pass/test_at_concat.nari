// Test @ string concatenation operator

// Basic concatenation
let hello = "Hello";
let world = "World";
let greeting = hello @ " " @ world @ "!";
print(greeting);

// Concatenating different types (should convert to string)
let num = 42;
let result = "The answer is " @ num;
print(result);

// Multiple concatenations
let a = "A";
let b = "B";
let c = "C";
print(a @ b @ c);

// Empty strings
print("" @ "text" @ "");

// Numbers
let x = 10;
let y = 20;
print(x @ " + " @ y @ " = " @ (x + y));

// With booleans
let flag = true;
print("Flag is: " @ flag);

// Mixed with string interpolation
let name = "Alice";
print("Hello " @ name @ ", your greeting is " @ `Welcome, {name}!`);

// Chained operations
let msg = "First" @ " " @ "Second" @ " " @ "Third";
print(msg);

// With object property
let obj = {name: "Bob", age: 25};
print("Name: " @ obj.name @ ", Age: " @ obj["age"]);

// With array element
let arr = ["red", "green", "blue"];
print("Colors: " @ arr[0] @ ", " @ arr[1] @ ", " @ arr[2]);