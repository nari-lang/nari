// Helper module used by tests/expect_pass/test_jit_cross_module_throw.nari.
// Each function throws a string. The throws must propagate cleanly back to the
// importing module's try/catch when the call site is JIT-compiled.

export func throw_simple() {
    throw "ERR_SIMPLE";
}

export func throw_via_helper() {
    inner_helper();
}

func inner_helper() {
    throw "ERR_NESTED";
}

// Helper that does some arithmetic before throwing, encouraging JIT tracing.
export func throw_after_loop(n) {
    let i = 0;
    let acc = 0;
    while (i < n) {
        acc = acc + i;
        i = i + 1;
    }
    throw `ERR_AFTER_LOOP:{acc}`;
}
