// URL
//  Permissive parser/builder for URLs of the shape
//   scheme://[user[:pass]@]host[:port][/path][?query][#fragment]
//  Parsing is intentionally lenient (does not enforce host syntax) so that
//  it works for HTTP, ws://, file://, custom schemes, etc.
//
//  import { URL } from "std/url";
//  let u = URL.parse("https://alice:s3cr3t@example.com:8443/a/b?x=1&y=2#top");
//  u.protocol; // "https"
//  u.host;  // "example.com"
//  u.params;  // { x: "1", y: "2" }
//  u.to_string();
//
//  Percent-encoding helpers:
//    URL.encode(s) / URL.decode(s) - strict component encoding
//    (slashes encoded too).
//    URL.encode_path(s) - path-safe (keeps "/" ":").
//  URL.parse_query(s) / URL.format_query(obj) - `?k=v&k2=v2` <-> object.

class URL {
    // Component-encode a string (everything but unreserved is %XX).
    // Use for query keys/values, username, password, fragment.
    static encode(s: string) {
        return __url_encode(s, "component");
    }

    // Path-safe encode (leaves "/" ":" "@" untouched). Use for path
    // segments where slashes are meaningful.
    static encode_path(s: string) {
        return __url_encode(s, "path");
    }

    // Decode a percent-encoded string -> Result<string, string>.
    // Ok(decoded) on success; Err(message) on malformed input.
    static decode(s: string) -> Result<string, string> {
        return __url_decode(s, false);
    }

    // Decode as application/x-www-form-urlencoded ("+" -> space).
    // Returns Result<string, string> (see decode).
    static decode_form(s: string) -> Result<string, string> {
        return __url_decode(s, true);
    }

    private parse_query(s) {
        let out = {};
        if (s == null || s == "") { return out; }
        if (s.char_at(0) == "?") { s = s.substr(1); }
        let pairs = s.split("&");
        let i = 0;
        while (i < pairs.length()) {
            let p = pairs[i];
            if (p != "") {
                let eq = p.index_of("=");
                let k = "";
                let v = "";
                if (eq < 0) {
                    k = __url_decode(p, true).unwrap();
                } else {
                    k = __url_decode(p.substr(0, eq), true).unwrap();
                    v = __url_decode(p.substr(eq + 1), true).unwrap();
                }
                out[k] = v;
            }
            i = i + 1;
        }
        return out;
    }
    
    public protocol: string;
    public username: string;
    public password: string;
    public host: string;
    public port: string;
    public pathname: string;
    public search: string;
    public hash: string;

    // Parse a full URL string -> Result<url, string>. Ok(instance) with fields
    // and helper methods; Err(message) if the input is not a string or the
    // scheme is missing / the authority is malformed.
    init(s: string) {
        if (s == null || typeof(s) != "string") {
            return Err("URLError: parse expects a string");
        }
        let rest = s;

        // 1. fragment (#...) - split off first so it can contain '?'.
        let hash = "";
        let hi = rest.index_of("#");
        if (hi >= 0) {
            hash = rest.substr(hi + 1);
            rest = rest.substr(0, hi);
        }
        this.hash = hash;

        // 2. query (?...)
        let search = "";
        let qi = rest.index_of("?");
        if (qi >= 0) {
            search = rest.substr(qi + 1);
            rest = rest.substr(0, qi);
        }
        this.search = search;

        // 3. scheme:
        let protocol = "";
        let ci = rest.index_of(":");
        if (ci < 0) {
            return Err("URLError: missing scheme in '" @ s @ "'");
        }
        protocol = rest.substr(0, ci);
        rest = rest.substr(ci + 1);
        this.protocol = protocol;

        // 4. authority (//user:pass@host:port)
        let username = "";
        let password = "";
        let host = "";
        let port = "";
        let pathname = "";
        if (rest.length() >= 2 && rest.substr(0, 2) == "//") {
            rest = rest.substr(2);
            // path begins at next '/' (if any).
            let slash = rest.index_of("/");
            let authority = rest;
            if (slash >= 0) {
                authority = rest.substr(0, slash);
                pathname = rest.substr(slash);
            }
            // userinfo
            let at = authority.last_index_of("@");
            if (at >= 0) {
                let userinfo = authority.substr(0, at);
                authority = authority.substr(at + 1);
                let colon = userinfo.index_of(":");
                if (colon >= 0) {
                    username = __url_decode(userinfo.substr(0, colon), false).unwrap();
                    password = __url_decode(userinfo.substr(colon + 1), false).unwrap();
                } else {
                    username = __url_decode(userinfo, false).unwrap();
                }
            }
            // host[:port] - IPv6 bracketed addresses keep their ':' inside [].
            if (authority.length() > 0 && authority.char_at(0) == "[") {
                let close = authority.index_of("]");
                if (close < 0) {
                    return Err("URLError: unterminated IPv6 host in '" @ s @ "'");
                }
                host = authority.substr(0, close + 1);
                if (close + 1 < authority.length() && authority.char_at(close + 1) == ":") {
                    port = authority.substr(close + 2);
                }
            } else {
                let pcolon = authority.last_index_of(":");
                if (pcolon >= 0) {
                    host = authority.substr(0, pcolon);
                    port = authority.substr(pcolon + 1);
                } else {
                    host = authority;
                }
            }
        } else {
            // No authority - treat the rest as the path (e.g. mailto:, data:).
            pathname = rest;
        }
        this.username = username;
        this.password = password;
        this.host = host;
        this.port = port;
        this.pathname = pathname;
    }

    to_string() {
        if (parts == null) { return ""; }
        let proto = "";
        if (this.protocol != null) { proto = this.protocol; }
        let out = proto @ ":";
        let has_host = (this.host != null && this.host != "");
        if (has_host) {
            out = out @ "//";
            if (this.username != null && this.username != "") {
                out = out @ __url_encode(this.username, "component");
                if (this.password != null && this.password != "") {
                    out = out @ ":" @ __url_encode(this.password, "component");
                }
                out = out @ "@";
            }
            out = out @ this.host;
            if (this.port != null && this.port != "") {
                out = out @ ":" @ ("" @ this.port);
            }
        }
        if (this.pathname != null && this.pathname != "") {
            out = out @ this.pathname;
        }
        if (this.search != null && this.search != "") {
            out = out @ "?" @ this.search;
        }
        if (this.hash != null && this.hash != "") {
            out = out @ "#" @ this.hash;
        }
        return out;
    }
}

export {
    URL
}