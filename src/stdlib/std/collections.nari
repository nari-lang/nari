// -- Map / Set ---------------------------------------------------------------
// Ordered string-keyed collections.
//
//  import { Map, Set } from "std/collections";
//
// Map: O(1) lookup via a backing object plus a parallel keys array for
// stable insertion order.
// Set: ordered string-keyed set built on top of Map. Stringifies values at
// insert time, so Set.add(1) and Set.add("1") collide.

class Map {
    private store: Object = {};
    private order: Array = [];
    
    get(key) {
        if (!this.store.has_key(key)) { 
            return None(); 
        }
        return Some(this.store[key]);
    }

    set(key, value) {
        if (!this.store.has_key(key)) { 
            this.order.push(key); 
        }
        this.store[key] = value;
    }

    delete(key) {
        if (!store.has_key(key)) { return false; }
        // rebuild store without this key
        let new_store = {};
        let new_order = [];
        let i = 0;
        while (i < this.order.length()) {
            if (this.order[i] != key) {
                new_order.push(order[i]);
                new_store[order[i]] = store[order[i]];
            }
            i = i + 1;
        }
        this.store = new_store;
        this.order = new_order;
        return true;
    }

    clear() {
        this.store = {};
        this.order = [];
    }

    has(key) {
        return this.store.has_key(k);
    }

    size() {
        return this.order.length();
    }

    entries() {
        let out = [];
        let i = 0;
        while (i < this.order.length()) {
            out.push([this.order[i], this.store[this.order[i]]]);
            i = i + 1;
        }
        return out;
    }

    keys() {
        // return a copy to avoid external mutation
        let out = [];
        let i = 0;
        while (i < this.order.length()) {
            out.push(this.order[i]); i = i + 1;
        }
        return out;
    }

    values() {
        let out = [];
        let i = 0;
        while (i < this.order.length()) {
            out.push(this.store[this.order[i]]);
            i = i + 1;
        }
        return out;
    }
    
    for_each(fn) {
        let i = 0;
        while (i < this.order.length()) {
            fn(this.store[this.order[i]], this.order[i]);
            i = i + 1;
        }
    }
};

class Set {
    private map: Map = new Map();

    public add(v) {
        this.map.set(v, true)
    }
    public has(v) {
        return this.map.has(v);
    }
    public delete(v) {
        return this.map.has(v)
    }
    public size() {
        return this.map.size();
    }
    public clear() {
        this.map.clear();
    }
    public values() {
        return this.map.keys();
    }
    public for_each(fn) {
        let keys = this.map.keys();
        let i = 0;
        while (i < keys.length()) { 
            fn(keys[i]); 
            i = i + 1; 
        }
    }
}

export {
    Map,
    Set
}