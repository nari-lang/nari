// Map / Set
//  Ordered string-keyed collections.
//
//  import { Map, Set } from "std/collections";
//
//  Map: O(1) lookup via a backing object plus a parallel keys array for stable insertion order.
//  Set: ordered string-keyed set built on top of Map. Stringifies values at
//       insert time, so Set.add(1) and Set.add("1") collide.

export let Map = {
    create: func() {
        let store = {};
        let order = [];

        return {
            set: func(k, v) {
                let key = "" @ k;
                if (!store.has_key(key)) { order.push(key); }
                store[key] = v;
            },
            get: func(k) {
                let key = "" @ k;
                if (!store.has_key(key)) { return null; }
                return store[key];
            },
            has: func(k) { return store.has_key("" @ k); },
            delete: func(k) {
                let key = "" @ k;
                if (!store.has_key(key)) { return false; }
                // rebuild store without this key
                let new_store = {};
                let new_order = [];
                let i = 0;
                while (i < order.length()) {
                    if (order[i] != key) {
                        new_order.push(order[i]);
                        new_store[order[i]] = store[order[i]];
                    }
                    i = i + 1;
                }
                store = new_store;
                order = new_order;
                return true;
            },
            size: func() { return order.length(); },
            clear: func() {
                store = {};
                order = [];
            },
            keys: func() {
                // return a copy to avoid external mutation
                let out = [];
                let i = 0;
                while (i < order.length()) {
                    out.push(order[i]); i = i + 1;
                }
                return out;
            },
            values: func() {
                let out = [];
                let i = 0;
                while (i < order.length()) {
                    out.push(store[order[i]]);
                    i = i + 1;
                }
                return out;
            },
            entries: func() {
                let out = [];
                let i = 0;
                while (i < order.length()) {
                    out.push([order[i], store[order[i]]]);
                    i = i + 1;
                }
                return out;
            },
            for_each: func(fn) {
                let i = 0;
                while (i < order.length()) {
                    fn(store[order[i]], order[i]);
                    i = i + 1;
                }
            }
        }
    }
}

export let Set = {
    create: func(initial) {
        let m = Map.create();
        if (initial != null) {
            let i = 0;
            while (i < initial.length()) {
                m.set(initial[i], true);
                i = i + 1;
            }
        }

        return {
            add: func(v) { m.set(v, true); },
            has: func(v) { return m.has(v); },
            delete: func(v) { return m.delete(v); },
            size: func() { return m.size(); },
            clear: func() { m.clear(); },
            values: func() { return m.keys(); },
            for_each: func(fn) {
                let keys = m.keys();
                let i = 0;
                while (i < keys.length()) { fn(keys[i]); i = i + 1; }
            }
        };
    }
};
