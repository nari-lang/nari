// -- Regex -------------------------------------------------------------------
// Stdlib surface over the runtime's regex engine (SRELL, ECMAScript syntax).
// Lets you build regexes from dynamic strings (literals like /foo/i remain
// the primary form). Returns/uses native regex values, so .test() / .exec()
// remain available as methods.
//
// import { Regex } from "std/regex";

class Regex {
    static escape(s) {
        let meta = ".*+?^$()[]{}|\\/";
        let out = "";
        let i = 0;
        while (i < s.length()) {
            let c = s.char_at(i);
            if (meta.index_of(c) >= 0) {
                out = out + "\\" + c;
            } else {
                out = out + c;
            }
            i = i + 1;
        }
        return out;
    }
    private regex: Regex;

    init(pattern, flags) {
        if (flags == null) { flags = ""; }
        this.regex = __regex_new(pattern, flags).unwrap();
    }
    exec(str) {
        return this.regex.exec(str);
    }
    test(str) {
        return this.regex.test(str);
    }
    split(str) {
        let parts = [];
        let rest = str;
        let safety = 0;
        while (true) {
            let m = this.regex.exec(rest);
            if (m == null) {
                parts.push(rest);
                return parts;
            }
            if (m.value.length() == 0) {
                // zero-width match: emit the rest as one piece, avoid infinite loop
                parts.push(rest);
                return parts;
            }
            parts.push(rest.substr(0, m.index));
            rest = rest.substr(m.index + m.value.length());
            safety = safety + 1;
            if (safety > 100000) { return parts; }
        }
        return parts;
    }
    replace(str, replacement) {
        let m = this.regex.exec(str);
        if (m == null) { return str; }
        return str.substr(0, m.index) + replacement + str.substr(m.index + m.value.length());
    }
    replace_all(str, replacement) {
        let out = "";
        let rest = str;
        let safety = 0;
        while (true) {
            let m = this.regex.exec(rest);
            if (m == null) {
                return out + rest;
            }
            out = out + rest.substr(0, m.index) + replacement;
            if (m.value.length() == 0) {
                // zero-width: consume one char to make progress
                if (m.index < rest.length()) {
                    out = out + rest.char_at(m.index);
                    rest = rest.substr(m.index + 1);
                } else {
                    return out;
                }
            } else {
                rest = rest.substr(m.index + m.value.length());
            }
            safety = safety + 1;
            if (safety > 100000) { return out + rest; }
        }
        return out;
    }
}