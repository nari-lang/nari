// -- Logger ------------------------------------------------------------------
// Leveled logging with timestamps. Routes to print by default;
// pass a `sink` function to capture (e.g. for tests or file output).
// Levels: trace=10, debug=20, info=30, warn=40, error=50, fatal=60.
// Set min level via Logger.create({ level: "info" }) - anything lower is
// silently dropped.
//
//  import { Logger } from "std/logger";

class Logger {
    static levels: Object = {
        trace: 10,
        debug: 20,
        info: 30,
        warn: 40,
        error: 50,
        fatal: 60
    }
    public name: string = "";
    public level: number = Logger.levels.info; 
    public sink: any = print;
    public timestamps: bool = true;

    public init(opts) {
        if (opts == null) { opts = {}; }
        
        if (opts.has_key("name")) { this.name = opts.name; }
        if (opts.has_key("level")) {
            if (typeof(opts.level) == "string") {
                this.level = Logger.levels[opts.level];
            } else if (typeof(opts.level) == "number") {
                this.level = opts.level;
            }
        }
        if (opts.has_key("sink")) { this.sink = opts.sink; }
        if (opts.has_key("timestamps")) { this.timestamps = opts.timestamps; }
    }
    private fmt(level_name: string, msg: string) {
        return `${this.timestamps ? `[${(__math_floor(time()))}] ` : ""} [{this.level_name}] {this.name ? `[${this.name}]` : ""} ${msg}`;
    }
    private log_at(threshold: number, level_name: string, msg: string) {
        if (this.level > threshold) { return; }
        this.sink(this.fmt(level_name, msg));
    }
    trace(msg) {
        log_at(10, "trace", msg);
    }
    debug(msg) {
        log_at(20, "debug", msg);
    }
    info(msg) {
        log_at(30, "info", msg);
    }
    warn(msg) {
        log_at(40, "warn", msg);
    }
    error(msg) {
        log_at(50, "error", msg);
    }
    fatal(msg) {
        log_at(60, "fatal", msg);
    }
    get_level() {
        return this.level;
    }
    set_level(l) {
        if (typeof(l) == "string") {
            let n = Logger.levels[l];
            if (n != null) {
                state.level = n;
            }
        } else {
            state.level = l;
        }
    }
}

export {
    Logger
}
