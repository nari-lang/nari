// -- Logger ------------------------------------------------------------------
// Leveled logging with timestamps. Routes to print by default;
// pass a `sink` function to capture (e.g. for tests or file output).
// Levels: trace=10, debug=20, info=30, warn=40, error=50, fatal=60.
// Set min level via Logger.create({ level: "info" }) - anything lower is
// silently dropped.
//
//  import { Logger } from "std/logger";

export let Logger = {
    levels: {
        trace: 10,
        debug: 20,
        info: 30,
        warn: 40,
        error: 50,
        fatal: 60
    },

    // Logger.create(opts?) -> logger instance.
    // opts: { name?: string, level?: string|int=info, sink?: func(line),
    //  timestamps?: bool=true }
    create: func(opts) {
        if (opts == null) { opts = {}; }

        let name = opts.has_key("name") ? opts.name : "";
        let level = opts.has_key("level") ? opts.level : "info";
        if (typeof(level) == "string") {
            level = Logger.levels[level];
            if (level == null) { level = 30; }
        }
        let sink = opts.has_key("sink") ? opts.sink : print;
        let use_ts = opts.has_key("timestamps") ? opts.timestamps : true;
        let state = { level: level };

        let fmt = func(level_name, msg) {
            let line = "";
            if (use_ts) { line = "[" + ("" @ __math_floor(time())) + "] "; }
            line = line + "[" + level_name + "]";
            if (name != "") { line = line + " [" + name + "]"; }
            return line + " " + msg;
        };

        let log_at = func(threshold, level_name, msg) {
            if (state.level > threshold) { return; }
            sink(fmt(level_name, msg));
        };

        return {
            trace: func(msg) { log_at(10, "trace", msg); },
            debug: func(msg) { log_at(20, "debug", msg); },
            info: func(msg) { log_at(30, "info", msg); },
            warn: func(msg) { log_at(40, "warn", msg); },
            error: func(msg) { log_at(50, "error", msg); },
            fatal: func(msg) { log_at(60, "fatal", msg); },
            // set_level(name|int) -> update minimum level
            set_level: func(l) {
                if (typeof(l) == "string") {
                    let n = Logger.levels[l];
                    if (n != null) {
                        state.level = n;
                    }
                } else {
                    state.level = l;
                }
            },
            get_level: func() { return state.level; }
        };
    }
};
