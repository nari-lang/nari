// Date
//  Wall-clock time. All timestamps are integer milliseconds since the Unix epoch.
//
//  import { Date } from "std/date";
//  let d = Date.from_ms(Date.now());
//  d.year; d.month; d.day; d.to_iso_string();
//
//  Format strings use C strftime with one extension: "%L" -> 3-digit milliseconds.

class Date {
    static now() { return __time_now_ms(); }
    static parse_iso(s) { return __time_parse_iso(s); }
    static utc(year, month, day, hour, minute, second, ms) {
        if (hour == null) { hour = 0; }
        if (minute == null) { minute = 0; }
        if (second == null) { second = 0; }
        if (ms == null) { ms = 0; }
        return __time_from_components({
                year: year,
                month: month,
                day: day,
                hour: hour,
                minute: minute,
                second: second,
                ms: ms
            }, true).unwrap();
    }
    private utc: bool = true;

    init(ms: number, opts) {
        if (opts == null) { opts = {}; }
        if (opts.has_key("utc")) { this.utc = opts.utc; }
        let c = __time_components(ms, this.utc).unwrap();
        this.ms = ms;
        this.year = c.year; 
        this.day = c.day;
        this.month = c.month;
        this.weekday = c.weekday;
        this.yearday = c.yearday;
        this.hour = c.hour; 
        this.minute = c.minute;
        this.second = c.second;
        this.millis = c.ms;
    }

    add_ms(n: number) -> Date {
        return new Date(this.ms + n, { utc: this.utc });
    }
    diff_ms(other: Date) -> number {
        return this.ms - other.ms;
    }
    equals(other: Date) -> bool {
        return this.ms == other.ms;
    }
    to_iso_string() -> string {
        // Hand-format to guarantee canonical YYYY-MM-DDTHH:MM:SS.sssZ
        // (strftime's %Y zero-pads to >=4 but not exactly 4 across libc
        // versions for negative years; we don't support BCE here).
        let pad2 = func(n) {
            if (n < 10) { return "0" @ ("" @ n); }
            return "" @ n;
        };
        let pad3 = func(n) {
            if (n < 10) { return "00" @ ("" @ n); }
            if (n < 100) { return "0" @ ("" @ n); }
            return "" @ n;
        };
        let pad4 = func(n) {
            if (n < 10) { return "000" @ ("" @ n); }
            if (n < 100) { return "00" @ ("" @ n); }
            if (n < 1000) { return "0" @ ("" @ n); }
            return "" @ n;
        };
        let suffix = "";
        if (this.utc) { suffix = "Z"; }
        return pad4(this.year) @ "-" @ pad2(this.month) @ "-" @ pad2(this.day)
        @ "T" @ pad2(this.hour) @ ":" @ pad2(this.minute) @ ":" @ pad2(this.second)
        @ "." @ pad3(this.millis) @ suffix;
    }
    format(fmt) {
        return __time_format(this.ms, fmt, this.utc).unwrap();
    }
}

export {
    Date
}
