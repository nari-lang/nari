// Hex / Base64
//  Binary-safe Hex / Base64 codecs backed by native builtins. They operate
//  on raw byte strings (bytes 0-255), unlike from_char_code (capped at 127).
//
//  import { Hex, Base64 } from "std/encoding";

class Hex {
    static encode(str: string) -> string {
        return __hex_encode(str);
    }
    static decode(hex: string) -> string {
        return __hex_decode(hex);
    }
}
class Base64 {
    static encode(str: string) -> string {
        return __base64_encode(str);
    }
    static decode(b64: string) -> string {
        return __base64_decode(b64);
    }
};

export {
    Hex,
    Base64,
}