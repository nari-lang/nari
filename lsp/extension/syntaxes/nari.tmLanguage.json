{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nari",
  "scopeName": "source.nari",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#template-strings" },
    { "include": "#keywords" },
    { "include": "#class-declaration" },
    { "include": "#function-declaration" },
    { "include": "#type-declaration" },
    { "include": "#enum-declaration" },
    { "include": "#builtin-functions" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.nari",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.nari" } },
          "endCaptures":   { "0": { "name": "punctuation.definition.comment.nari" } }
        },
        {
          "name": "comment.line.double-slash.nari",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.nari",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nari",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.nari" } },
          "endCaptures":   { "0": { "name": "punctuation.definition.string.end.nari"   } },
          "patterns": [
            { "name": "constant.character.escape.nari", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.nari",
          "begin": "'",
          "end": "'",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.nari" } },
          "endCaptures":   { "0": { "name": "punctuation.definition.string.end.nari"   } },
          "patterns": [
            { "name": "constant.character.escape.nari", "match": "\\\\." }
          ]
        }
      ]
    },
    "template-strings": {
      "name": "string.template.nari",
      "begin": "`",
      "end": "`",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.template.begin.nari" } },
      "endCaptures":   { "0": { "name": "punctuation.definition.string.template.end.nari"   } },
      "patterns": [
        {
          "name": "meta.template.expression.nari",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.nari" } },
          "endCaptures":   { "0": { "name": "punctuation.definition.template-expression.end.nari"   } },
          "patterns": [ { "include": "$self" } ]
        },
        { "name": "constant.character.escape.nari", "match": "\\\\." }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nari",
          "match": "\\b(if|else|while|for|foreach|in|break|continue|return|switch|case|default|try|catch|finally|throw|match|spawn|await)\\b"
        },
        {
          "name": "keyword.declaration.nari",
          "match": "\\b(let|global|func|class|type|enum|import|export|new)\\b"
        },
        {
          "name": "storage.modifier.nari",
          "match": "\\b(public|private)\\b"
        },
        {
          "name": "variable.language.nari",
          "match": "\\b(this|self)\\b"
        }
      ]
    },
    "class-declaration": {
      "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:<([A-Za-z_,\\s]+)>)?(?:\\s+(extends)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
      "captures": {
        "1": { "name": "keyword.declaration.nari" },
        "2": { "name": "entity.name.class.nari" },
        "3": { "name": "entity.name.type.parameter.nari" },
        "4": { "name": "keyword.other.nari" },
        "5": { "name": "entity.name.class.nari" }
      }
    },
    "function-declaration": {
      "match": "\\b(func)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.nari" },
        "2": { "name": "entity.name.function.nari" }
      }
    },
    "type-declaration": {
      "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:<([A-Za-z_,\\s]+)>)?",
      "captures": {
        "1": { "name": "keyword.declaration.nari" },
        "2": { "name": "entity.name.type.nari" },
        "3": { "name": "entity.name.type.parameter.nari" }
      }
    },
    "enum-declaration": {
      "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:<([A-Za-z_,\\s]+)>)?",
      "captures": {
        "1": { "name": "keyword.declaration.nari" },
        "2": { "name": "entity.name.type.enum.nari" },
        "3": { "name": "entity.name.type.parameter.nari" }
      }
    },
    "builtin-functions": {
      "name": "support.function.nari",
      "match": "\\b(print|println|to_string|to_number|to_bool|len|type|assert|range|exit|push|pop|shift|unshift|splice|slice|index_of|includes|join|split|trim|replace|contains|keys|values|entries|has_key)\\b(?=\\s*\\()"
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.nari", "match": "\\b(true|false)\\b" },
        { "name": "constant.language.null.nari",    "match": "\\bnull\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.nari",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.nari",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.nari",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.nari",
          "match": "->"
        },
        {
          "name": "keyword.operator.string-concat.nari",
          "match": "@(?!=)"
        },
        {
          "name": "keyword.operator.assignment.nari",
          "match": "(\\+=|-=|\\*=|/=|%=|@=|=)(?!=)"
        },
        {
          "name": "keyword.operator.comparison.nari",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.nari",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arithmetic.nari",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.scope.nari",
          "match": "::"
        },
        {
          "name": "keyword.operator.ternary.nari",
          "match": "[?:]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.statement.nari",  "match": ";" },
        { "name": "punctuation.separator.comma.nari",       "match": "," },
        { "name": "punctuation.separator.dot.nari",         "match": "\\." },
        { "name": "punctuation.definition.block.nari",      "match": "[{}]" },
        { "name": "punctuation.definition.bracket.nari",    "match": "[\\[\\]]" },
        { "name": "punctuation.definition.parameters.nari", "match": "[()]" }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.function.nari",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*\\()"
        },
        {
          "name": "entity.name.type.nari",
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\b"
        },
        {
          "name": "variable.other.nari",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
